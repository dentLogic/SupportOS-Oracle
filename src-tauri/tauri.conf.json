{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupportOS-Oracle",
  "version": "0.1.0",
  "identifier": "com.dentlogic.supportos-oracle",
  "build": {
    "beforeDevCommand": "cd crates/ui && trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd crates/ui && trunk build",
    "frontendDist": "../crates/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SupportOS Oracle",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
